{
  "id": "shorts",
  "name": "短视频",
  "version": "1.5.0",
  "api_version": 2,
  "min_host_version": "0.3.1",
  "description": "随机播放网盘文件夹里的视频，支持滑动切换、进度拖动、收藏和下载。",
  "author": "tgdrive",
  "entry": "index.html",
  "icon": "icon.svg",
  "permissions": [
    "files.read",
    "media.read",
    "favorites.write"
  ],
  "settings": [
    {
      "key": "source_dir",
      "label": "取材文件夹",
      "description": "播放此文件夹及子目录中的视频；根目录表示整库。",
      "type": "directory",
      "default": "/"
    },
    {
      "key": "muted",
      "label": "静音播放",
      "description": "静音时更容易自动播放；播放页面切换声音后会记住选择。",
      "type": "boolean",
      "default": true
    }
  ],
  "integration": {
    "file_types": [
      "mp4",
      "mov",
      "m4v",
      "mkv",
      "webm",
      "avi",
      "wmv",
      "flv",
      "ts",
      "mts",
      "m2ts",
      "3gp",
      "ogv"
    ],
    "directories": false,
    "changelog": "界面统一为共享深色规范：右侧竖排线性图标、底部标题与进度条，手机隐藏上下切换按钮；保留全部播放、滑动切换、收藏和设置功能。",
    "formats": [
      "网盘视频"
    ],
    "limitations": [
      "播放能力取决于浏览器；不提供转码。",
      "列表分页加载；切换或关闭时取消旧视频读取。"
    ],
    "homepage": "https://github.com/lengyuesky/tgdrive-app",
    "support": "https://github.com/lengyuesky/tgdrive-app/issues",
    "screenshots": [
      "screenshots/home.png"
    ],
    "data_schema": 1
  }
}

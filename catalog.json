    {
      "manifest": {
        "id": "fntv",
        "name": "飞牛影视服务",
        "version": "0.1.3",
        "api_version": 2,
        "min_host_version": "0.3.7",
        "description": "通过独立影视账号，让飞牛影视客户端浏览和播放已授权的网盘媒体库。安装后需配置账号、创建媒体库并主动启动。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read",
          "fntv.service"
        ],
        "settings": [],
        "integration": {
          "file_types": [],
          "directories": false,
          "changelog": "管理页界面改版：配色跟随主站深浅色，手机沉浸并自带返回网盘；服务状态与启停置顶，并提示启动前还缺哪些步骤；连接地址可一键复制；账号、媒体库和封面改为分组列表。服务能力不变，更新保留账号、媒体库、观看记录和运行状态。",
          "formats": [
            "网盘视频",
            "同目录 NFO 和海报",
            "Telegram 缩略图",
            "视频截帧",
            "文本字幕"
          ],
          "limitations": [
            "截帧受读取、解码和时间预算限制，失败时保留占位和播放入口；完成后需刷新客户端列表或重新进入页面。",
            "首期单用户，与原影视页面应用的媒体库、收藏和观看进度独立。",
            "需要宿主媒体探测及截图组件；不提供转码或联网刮削。",
            "未安装、未授权或未启动时不提供客户端访问。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [],
          "data_schema": 1
        }

    {
      "manifest": {
        "id": "books",
        "name": "图书",
        "version": "1.6.6",
        "api_version": 2,
        "min_host_version": "0.3.1",
        "description": "阅读网盘里的 TXT、EPUB 和 PDF，支持章节、排版设置、书签和跨设备阅读进度。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read"
        ],
        "settings": [],
        "integration": {
          "file_types": [
            "txt",
            "epub",
            "pdf"
          ],
          "directories": false,
          "changelog": "只读请求统一限并发并优先正文与当前页，封面读取降低优先级；限流退避加入随机抖动，排队可取消且有容量与时间上限，不阻塞进度保存和退出。",
          "formats": [
            "TXT",
            "EPUB 2/3",
            "PDF"
          ],
          "limitations": [
            "支持无 DRM 的 EPUB；不执行书内脚本或外部资源。",
            "支持 TXT 64 MiB、EPUB 128 MiB、PDF 512 MiB；大文件采用按需读取。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "c96794d3319025bd65bf455756ded0e0079b4c271658874e07877a11524982d4",
      "size": 2332211,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/books-1.6.6.tgapp"
    },

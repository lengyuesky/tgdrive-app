  "entries": [
    {
      "manifest": {
        "id": "books",
        "name": "图书",
        "version": "1.6.5",
        "api_version": 2,
        "min_host_version": "0.3.1",
        "description": "阅读网盘里的 TXT、EPUB 和 PDF，支持章节、排版设置、书签和跨设备阅读进度。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read"
        ],
        "settings": [],
        "integration": {
          "file_types": [
            "txt",
            "epub",
            "pdf"
          ],
          "directories": false,
          "changelog": "阅读馆初始化、首页和书库失败可原地重试并保留分页筛选；修复旧请求覆盖、续读键盘重复触发及返回书库时点击被刷新打断。只读请求遇宿主限流时自动退避重试，支持取消。",
          "formats": [
            "TXT",
            "EPUB 2/3",
            "PDF"
          ],
          "limitations": [
            "支持无 DRM 的 EPUB；不执行书内脚本或外部资源。",
            "支持 TXT 64 MiB、EPUB 128 MiB、PDF 512 MiB；大文件采用按需读取。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "a9701d97c62a50e3754f9221ef1d13921ec38a14f17ff75f6d49b31cf3dc3d6c",
      "size": 2331392,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/books-1.6.5.tgapp"
    },
    {
      "manifest": {
        "id": "cinema",
        "name": "影视",
        "version": "1.4.3",
        "api_version": 2,
        "min_host_version": "0.3.0",
        "description": "你的私人影院。自建命名媒体库并绑定文件夹，进入后才加载视频；支持收藏、续播、文本字幕和客户端 MKV 流式转封装，不使用服务器转码。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read"
        ],
        "settings": [],
        "integration": {
          "file_types": [
            "mp4",
            "mov",
            "m4v",
            "mkv",
            "webm",
            "avi",
            "wmv",
            "flv",
            "ts",
            "mts",
            "m2ts",
            "3gp",
            "ogv"
          ],
          "directories": false,
          "changelog": "影院初始化、媒体库分页和影片详情支持原地重试，保留搜索与页码，修复旧详情播放标签残留。只读请求遇宿主限流时自动退避重试，支持取消。",
          "formats": [
            "浏览器支持的视频",
            "MKV 客户端解封装",
            "SRT/VTT/ASS 字幕"
          ],
          "limitations": [
            "播放能力取决于浏览器支持的编码；不提供服务端转码。",
            "媒体库按需加载，不联网刮削；不支持的编码可下载原文件。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "8361af4248d6913d593782679d2acac2f4692369af6c97ff71046f80f9b37057",
      "size": 222156,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/cinema-1.4.3.tgapp"
    },
    {
      "manifest": {
        "id": "comics",
        "name": "漫画",
        "version": "1.4.5",
        "api_version": 2,
        "min_host_version": "0.3.1",
        "description": "阅读图片文件夹和 CBZ/ZIP 漫画，支持封面海报、连续滚动、左右单页翻阅、书签和跨设备阅读进度。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read"
        ],
        "settings": [],
        "integration": {
          "file_types": [
            "cbz",
            "zip"
          ],
          "directories": true,
          "changelog": "阅读馆初始化、首页和书库失败可原地重试并保留分页筛选；修复旧请求覆盖、续读键盘重复触发及返回书库时点击被刷新打断。只读请求遇宿主限流时自动退避重试，支持取消。",
          "formats": [
            "图片目录",
            "CBZ",
            "ZIP"
          ],
          "limitations": [
            "不支持加密归档、RAR、CBR 或 7Z。",
            "归档上限 2 GiB，图片章最多 10000 页；按可见范围读取图片。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "cd56d4dc5412ce3a7f0904c8ad25cb7fdbf9a8aac970650df791bdcd2736c7a5",
      "size": 343023,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/comics-1.4.5.tgapp"
    },
    {
      "manifest": {
        "id": "shorts",
        "name": "短视频",
        "version": "1.4.4",
        "api_version": 2,
        "min_host_version": "0.3.1",
        "description": "随机播放网盘文件夹里的视频，支持滑动切换、进度拖动、收藏和下载。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read",
          "favorites.write"
        ],
        "settings": [
          {
            "key": "source_dir",
            "label": "取材文件夹",
            "description": "播放此文件夹及子目录中的视频；根目录表示整库。",
            "type": "directory",
            "default": "/"
          },
          {
            "key": "muted",
            "label": "静音播放",
            "description": "静音时更容易自动播放；播放页面切换声音后会记住选择。",
            "type": "boolean",
            "default": true
          }
        ],
        "integration": {
          "file_types": [
            "mp4",
            "mov",
            "m4v",
            "mkv",
            "webm",
            "avi",
            "wmv",
            "flv",
            "ts",
            "mts",
            "m2ts",
            "3gp",
            "ogv"
          ],
          "directories": false,
          "changelog": "修复分页等待时连续切换跳片及旧切换覆盖，及时更新队列数量，避免旧启动任务干扰当前视频。只读请求遇宿主限流时自动退避重试，支持取消。",
          "formats": [
            "网盘视频"
          ],
          "limitations": [
            "播放能力取决于浏览器；不提供转码。",
            "列表分页加载；切换或关闭时取消旧视频读取。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "504efb67fa7e56be7eb61cdfa49f8afaf0ddda083e2dc6219b8064bcca7f503d",

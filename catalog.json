  "entries": [
    {
      "manifest": {
        "id": "books",
        "name": "图书",
        "version": "1.6.7",
        "api_version": 2,
        "min_host_version": "0.3.1",
        "description": "阅读网盘里的 TXT、EPUB 和 PDF，支持章节、排版设置、书签和跨设备阅读进度。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read"
        ],
        "settings": [],
        "integration": {
          "file_types": [
            "txt",
            "epub",
            "pdf"
          ],
          "directories": false,
          "changelog": "新增宿主全库索引入口，跨子目录分页查找阅读文件并恢复浏览位置，不受 2000 项整理上限限制；文件树变化拒绝旧游标，旧宿主保留原有书库。",
          "formats": [
            "TXT",
            "EPUB 2/3",
            "PDF"
          ],
          "limitations": [
            "支持无 DRM 的 EPUB；不执行书内脚本或外部资源。",
            "支持 TXT 64 MiB、EPUB 128 MiB、PDF 512 MiB；大文件采用按需读取。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "751509340285b9c80db53361c4a2e8759c34f536495e4158140957918d84e1df",
      "size": 2335035,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/books-1.6.7.tgapp"
    },
    {
      "manifest": {
        "id": "cinema",
        "name": "影视",
        "version": "1.4.5",
        "api_version": 2,
        "min_host_version": "0.3.0",
        "description": "你的私人影院。自建命名媒体库并绑定文件夹，进入后才加载视频；支持收藏、续播、文本字幕和客户端 MKV 流式转封装，不使用服务器转码。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read"
        ],
        "settings": [],
        "integration": {
          "file_types": [
            "mp4",
            "mov",
            "m4v",
            "mkv",
            "webm",
            "avi",
            "wmv",
            "flv",
            "ts",
            "mts",
            "m2ts",
            "3gp",
            "ogv"
          ],
          "directories": false,
          "changelog": "同步公共 SDK 的可选宿主阅读索引接口，保持现有影院播放与有界请求调度行为。",
          "formats": [
            "浏览器支持的视频",
            "MKV 客户端解封装",
            "SRT/VTT/ASS 字幕"
          ],
          "limitations": [
            "播放能力取决于浏览器支持的编码；不提供服务端转码。",
            "媒体库按需加载，不联网刮削；不支持的编码可下载原文件。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "feadd039edf48620de79a064d658d3bb73bb00fa5740e1c9bd507508a12d0f21",
      "size": 222975,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/cinema-1.4.5.tgapp"
    },
    {
      "manifest": {
        "id": "comics",
        "name": "漫画",
        "version": "1.4.7",
        "api_version": 2,
        "min_host_version": "0.3.1",
        "description": "阅读图片文件夹和 CBZ/ZIP 漫画，支持封面海报、连续滚动、左右单页翻阅、书签和跨设备阅读进度。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read"
        ],
        "settings": [],
        "integration": {
          "file_types": [
            "cbz",
            "zip"
          ],
          "directories": true,
          "changelog": "新增宿主全库索引入口，跨子目录分页查找漫画包和图片目录并恢复浏览位置，不受 2000 项整理上限限制；文件树变化拒绝旧游标，旧宿主保留原有书库。",
          "formats": [
            "图片目录",
            "CBZ",
            "ZIP"
          ],
          "limitations": [
            "不支持加密归档、RAR、CBR 或 7Z。",
            "归档上限 2 GiB，图片章最多 10000 页；按可见范围读取图片。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "36d821cab960f517a02d59a0ce8f30118efb14170780b5e8d63e7f671fcd1883",
      "size": 346660,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/comics-1.4.7.tgapp"
    },
    {
      "manifest": {
        "id": "shorts",
        "name": "短视频",
        "version": "1.4.6",
        "api_version": 2,
        "min_host_version": "0.3.1",
        "description": "随机播放网盘文件夹里的视频，支持滑动切换、进度拖动、收藏和下载。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read",
          "favorites.write"
        ],
        "settings": [
          {
            "key": "source_dir",
            "label": "取材文件夹",
            "description": "播放此文件夹及子目录中的视频；根目录表示整库。",
            "type": "directory",
            "default": "/"
          },
          {
            "key": "muted",
            "label": "静音播放",
            "description": "静音时更容易自动播放；播放页面切换声音后会记住选择。",
            "type": "boolean",
            "default": true
          }
        ],
        "integration": {
          "file_types": [
            "mp4",
            "mov",
            "m4v",
            "mkv",
            "webm",
            "avi",
            "wmv",
            "flv",
            "ts",
            "mts",
            "m2ts",
            "3gp",
            "ogv"
          ],
          "directories": false,
          "changelog": "同步公共 SDK 的可选宿主阅读索引接口，保持现有短视频播放与有界请求调度行为。",
          "formats": [
            "网盘视频"
          ],
          "limitations": [
            "播放能力取决于浏览器；不提供转码。",
            "列表分页加载；切换或关闭时取消旧视频读取。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "41bbd45800f0caa93ff8038ef4dc77081f5e59edf8cf786703ef601add036f42",
      "size": 341451,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/shorts-1.4.6.tgapp"
    }

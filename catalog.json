  "entries": [
    {
      "manifest": {
        "id": "books",
        "name": "图书",
        "version": "1.6.2",
        "api_version": 2,
        "min_host_version": "0.3.1",
        "description": "阅读网盘里的 TXT、EPUB 和 PDF，支持章节、排版设置、书签和跨设备阅读进度。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read"
        ],
        "settings": [],
        "integration": {
          "file_types": [
            "txt",
            "epub",
            "pdf"
          ],
          "directories": false,
          "changelog": "统一使用应用内来源管理，移除旧目录设置和过渡迁移入口；保留阅读进度、书签及现有来源。",
          "formats": [
            "TXT",
            "EPUB 2/3",
            "PDF"
          ],
          "limitations": [
            "支持无 DRM 的 EPUB；不执行书内脚本或外部资源。",
            "支持 TXT 64 MiB、EPUB 128 MiB、PDF 512 MiB；大文件采用按需读取。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "376793094d28b52835143f8a430a38f89545053022464bdbfce998097c1adced",
      "size": 2330401,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/books-1.6.2.tgapp"
    },
    {
      "manifest": {
        "id": "cinema",
        "name": "影视",
        "version": "1.4.1",
        "api_version": 2,
        "min_host_version": "0.3.0",
        "description": "你的私人影院。自建命名媒体库并绑定文件夹，进入后才加载视频；支持收藏、续播、文本字幕和客户端 MKV 流式转封装，不使用服务器转码。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read"
        ],
        "settings": [],
        "integration": {
          "file_types": [
            "mp4",
            "mov",
            "m4v",
            "mkv",
            "webm",
            "avi",
            "wmv",
            "flv",
            "ts",
            "mts",
            "m2ts",
            "3gp",
            "ogv"
          ],
          "directories": false,
          "changelog": "支持从文件页直接打开、目录选择授权、文件定位与详情；加入版本化数据初始化、运行诊断及统一任务状态。",
          "formats": [
            "浏览器支持的视频",
            "MKV 客户端解封装",
            "SRT/VTT/ASS 字幕"
          ],
          "limitations": [
            "播放能力取决于浏览器支持的编码；不提供服务端转码。",
            "媒体库按需加载，不联网刮削；不支持的编码可下载原文件。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "f8fb4c7a77700dd6f00b4fbfcec4657c2626622ef62bfc176669c3dfe1e87c33",
      "size": 221384,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/cinema-1.4.1.tgapp"
    },
    {
      "manifest": {
        "id": "comics",
        "name": "漫画",
        "version": "1.4.2",
        "api_version": 2,
        "min_host_version": "0.3.1",
        "description": "阅读图片文件夹和 CBZ/ZIP 漫画，支持封面海报、连续滚动、左右单页翻阅、书签和跨设备阅读进度。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read"
        ],
        "settings": [],
        "integration": {
          "file_types": [
            "cbz",
            "zip"
          ],
          "directories": true,
          "changelog": "统一使用应用内来源管理，移除旧目录设置和过渡迁移入口；保留阅读进度、书签及现有来源。",
          "formats": [
            "图片目录",
            "CBZ",
            "ZIP"
          ],
          "limitations": [
            "不支持加密归档、RAR、CBR 或 7Z。",
            "归档上限 2 GiB，图片章最多 10000 页；按可见范围读取图片。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "54118bb58504ec378c21226399fcc69ca3b87cd4b41ddaf512325bd4e71730f1",
      "size": 342056,

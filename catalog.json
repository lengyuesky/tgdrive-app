  "entries": [
    {
      "manifest": {
        "id": "cinema",
        "name": "影视",
        "version": "1.5.1",
        "api_version": 2,
        "min_host_version": "0.3.0",
        "description": "你的私人影院。自建命名媒体库并绑定文件夹，进入后才加载视频；支持收藏、续播、文本字幕和客户端 MKV 流式转封装，不使用服务器转码。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read"
        ],
        "settings": [],
        "integration": {
          "file_types": [
            "mp4",
            "mov",
            "m4v",
            "mkv",
            "webm",
            "avi",
            "wmv",
            "flv",
            "ts",
            "mts",
            "m2ts",
            "3gp",
            "ogv"
          ],
          "directories": false,
          "changelog": "读取同目录 NFO 的标题、简介和年份，统一专属与共用海报优先级；电影与同番号版本保持独立播放，分段视频手动切换。",
          "formats": [
            "浏览器支持的视频",
            "MKV 客户端解封装",
            "SRT/VTT/ASS 字幕"
          ],
          "limitations": [
            "播放能力取决于浏览器支持的编码；不提供服务端转码。",
            "媒体库按需加载，不联网刮削；不支持的编码可下载原文件。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "50c805b2352b448f01389218650d1f6c62aecaeb2afb27a80eb2c82ac8a5e79d",
      "size": 175788,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/cinema-1.5.1.tgapp"
    },
    {
      "manifest": {
        "id": "fntv",
        "name": "飞牛影视服务",
        "version": "0.1.4",
        "api_version": 2,
        "min_host_version": "0.3.7",
        "description": "通过独立影视账号，让飞牛影视客户端浏览和播放已授权的网盘媒体库。安装后需配置账号、创建媒体库并主动启动。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read",
          "fntv.service"
        ],
        "settings": [],
        "integration": {
          "file_types": [],
          "directories": false,
          "changelog": "共用 SDK 兼容更新；宿主 0.3.10 可读取影视刮削生成的完整 NFO 和统一海报。",
          "formats": [
            "网盘视频",
            "同目录 NFO 和海报",
            "Telegram 缩略图",
            "视频截帧",
            "文本字幕"
          ],
          "limitations": [
            "截帧受读取、解码和时间预算限制，失败时保留占位和播放入口；完成后需刷新客户端列表或重新进入页面。",
            "首期单用户，与原影视页面应用的媒体库、收藏和观看进度独立。",
            "需要宿主媒体探测及截图组件；不提供转码或联网刮削。",
            "未安装、未授权或未启动时不提供客户端访问。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [],
          "data_schema": 1
        }
      },
      "sha256": "8bd43585e989897766916406e9805cf704ab3120ef10db78f3794d98559643f1",
      "size": 16386,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/fntv-0.1.4.tgapp"
    },
    {
      "manifest": {
        "id": "media-scraper",
        "name": "影视刮削",
        "version": "0.1.1",
        "api_version": 2,
        "min_host_version": "0.3.10",
        "description": "选择网盘目录后一键刮削所有子目录中的番号视频，自动补齐 NFO 与海报。不确定的项目直接跳过，关闭页面停止。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read",
          "scraper.service"
        ],
        "settings": [
          {
            "key": "backend_url",
            "label": "MetaTube 后端",
            "description": "保存的后端地址；Token 在应用连接页单独填写。",
            "type": "string",
            "default": "https://metatube-server.hf.space/"
          }
        ],
        "integration": {
          "file_types": [],
          "directories": true,
          "changelog": "简化为选择目录后点击开始：自动读取全部分页并连续刮削，不再选片、预览或确认候选；不确定项直接跳过，关闭页面停止，未完成项可一键重试。",
          "formats": [
            "MetaTube 番号影片",
            "NFO",
            "2:3 JPEG 海报",
            "文本字幕同行"
          ],
          "limitations": [
            "手动点击开始后在当前页面连续执行；关闭页面停止，保留已完成结果，重开不会自行续跑。",
            "无法唯一识别番号、多个精确来源或文件归属不确定时直接跳过。",
            "首期不自动翻译，不适配普通电影或电视剧联网资料源。",
            "MetaTube 来源可用性取决于所配置后端；飞牛兼容服务首期合计索引上限为 3000 条视频。",
            "Token 不进入数据库备份或应用恢复快照，恢复后需重新填写。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/desktop-preview.png",
            "screenshots/mobile-directory.png",
            "screenshots/mobile-preview.png",
            "screenshots/mobile-record.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "639ddf5dffb037d81f75b119c33db668cc40a55cd7411cfc32da40af63019d34",
      "size": 208467,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/media-scraper-0.1.1.tgapp"
    },
    {
      "manifest": {
        "id": "reader",
        "name": "阅读馆",
        "version": "1.1.2",
        "api_version": 2,
        "min_host_version": "0.3.3",
        "description": "在同一个书库阅读图书与漫画，支持继续阅读、想读、收藏、作品分组与跨设备阅读进度。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read"
        ],
        "settings": [],
        "integration": {
          "file_types": [
            "txt",
            "epub",
            "pdf",
            "cbz",
            "zip"
          ],
          "directories": true,
          "changelog": "修复纯图片 EPUB 在图片解码和缓存回收期间页数变化、提前跳章的问题，横竖屏保留稳定的图片尺寸。延续手机沉浸书库、跟手翻页及图标工具栏，升级保留书库、分组、阅读进度、书签及自定义偏好。",
          "formats": [
            "TXT",
            "EPUB 2/3",
            "PDF",
            "CBZ",
            "ZIP",
            "图片目录"
          ],
          "limitations": [
            "支持无 DRM 的 EPUB；不执行书内脚本或外部资源。",
            "支持 TXT 64 MiB、EPUB 128 MiB、PDF 512 MiB；大文件采用按需读取。",
            "不支持加密归档、RAR、CBR 或 7Z；漫画归档上限 2 GiB，图片章最多 10000 页。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png",
            "screenshots/mobile-library.png",
            "screenshots/mobile-reading.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "6f720c4ea849424ae69628e63710c830e44331eda02e45267c98be4412416b1e",
      "size": 2406915,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/reader-1.1.2.tgapp"
    },
    {
      "manifest": {
        "id": "shorts",
        "name": "短视频",
        "version": "1.5.1",
        "api_version": 2,
        "min_host_version": "0.3.1",
        "description": "随机播放网盘文件夹里的视频，支持滑动切换、进度拖动、收藏和下载。",
        "author": "tgdrive",
        "entry": "index.html",
        "icon": "icon.svg",
        "permissions": [
          "files.read",
          "media.read",
          "favorites.write"
        ],
        "settings": [
          {
            "key": "source_dir",
            "label": "取材文件夹",
            "description": "播放此文件夹及子目录中的视频；根目录表示整库。",
            "type": "directory",
            "default": "/"
          },
          {
            "key": "muted",
            "label": "静音播放",
            "description": "静音时更容易自动播放；播放页面切换声音后会记住选择。",
            "type": "boolean",
            "default": true
          }
        ],
        "integration": {
          "file_types": [
            "mp4",
            "mov",
            "m4v",
            "mkv",
            "webm",
            "avi",
            "wmv",
            "flv",
            "ts",
            "mts",
            "m2ts",
            "3gp",
            "ogv"
          ],
          "directories": false,
          "changelog": "界面统一为共享深色规范：右侧竖排线性图标、底部标题与进度条，手机隐藏上下切换按钮；保留全部播放、滑动切换、收藏和设置功能。",
          "formats": [
            "网盘视频"
          ],
          "limitations": [
            "播放能力取决于浏览器；不提供转码。",
            "列表分页加载；切换或关闭时取消旧视频读取。"
          ],
          "homepage": "https://github.com/lengyuesky/tgdrive-app",
          "support": "https://github.com/lengyuesky/tgdrive-app/issues",
          "screenshots": [
            "screenshots/home.png"
          ],
          "data_schema": 1
        }
      },
      "sha256": "1d021b455acdef18130d4073bdc160b77338782d59183dac69fb5d3b616e57fd",
      "size": 133151,
      "url": "https://raw.githubusercontent.com/lengyuesky/tgdrive-app/main/apps/shorts-1.5.1.tgapp"
    }
  ]
}

{
  "id": "books",
  "name": "图书",
  "version": "1.6.5",
  "api_version": 2,
  "min_host_version": "0.3.1",
  "description": "阅读网盘里的 TXT、EPUB 和 PDF，支持章节、排版设置、书签和跨设备阅读进度。",
  "author": "tgdrive",
  "entry": "index.html",
  "icon": "icon.svg",
  "permissions": [
    "files.read",
    "media.read"
  ],
  "settings": [],
  "integration": {
    "file_types": [
      "txt",
      "epub",
      "pdf"
    ],
    "directories": false,
    "changelog": "阅读馆初始化、首页和书库失败可原地重试并保留分页筛选；修复旧请求覆盖、续读键盘重复触发及返回书库时点击被刷新打断。只读请求遇宿主限流时自动退避重试，支持取消。",
    "formats": [
      "TXT",
      "EPUB 2/3",
      "PDF"
    ],
    "limitations": [
      "支持无 DRM 的 EPUB；不执行书内脚本或外部资源。",
      "支持 TXT 64 MiB、EPUB 128 MiB、PDF 512 MiB；大文件采用按需读取。"
    ],
    "homepage": "https://github.com/lengyuesky/tgdrive-app",
    "support": "https://github.com/lengyuesky/tgdrive-app/issues",
    "screenshots": [
      "screenshots/home.png"
    ],
    "data_schema": 1
  }
}

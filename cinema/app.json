{
  "id": "cinema",
  "name": "影视",
  "version": "1.0.7",
  "contract": { "major": 1, "minor": 0 },
  "description": "自建电影库和电视剧库，同目录同番号影片合并为一个条目，网页可选版本并分别续播；共用网页与飞牛客户端的收藏、已看标记和观看进度。网页支持文本字幕与 MKV 流式转封装；飞牛兼容服务须先配置独立连接账号，再由主人主动启动。",
  "author": "tgdrive",
  "files": { "read": true, "write": false },
  "page": { "entry": "page/index.html" },
  "backend": {
    "entry": "backend/app",
    "run_mode": "resident",
    "external_service": true
  },
  "icon": "assets/icon.svg",
  "required_capabilities": ["backend.proxy", "backend.external", "files.local_url", "read_leases"],
  "open_with": {
    "extensions": ["mp4", "m4v", "mov", "webm", "ogv", "mkv", "avi", "wmv", "flv", "ts", "mts", "m2ts", "3gp"],
    "directories": false
  }
}

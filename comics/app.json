{
  "id": "comics",
  "name": "漫画",
  "version": "1.4.2",
  "api_version": 2,
  "min_host_version": "0.3.1",
  "description": "阅读图片文件夹和 CBZ/ZIP 漫画，支持封面海报、连续滚动、左右单页翻阅、书签和跨设备阅读进度。",
  "author": "tgdrive",
  "entry": "index.html",
  "icon": "icon.svg",
  "permissions": [
    "files.read",
    "media.read"
  ],
  "settings": [],
  "integration": {
    "file_types": [
      "cbz",
      "zip"
    ],
    "directories": true,
    "changelog": "统一使用应用内来源管理，移除旧目录设置和过渡迁移入口；保留阅读进度、书签及现有来源。",
    "formats": [
      "图片目录",
      "CBZ",
      "ZIP"
    ],
    "limitations": [
      "不支持加密归档、RAR、CBR 或 7Z。",
      "归档上限 2 GiB，图片章最多 10000 页；按可见范围读取图片。"
    ],
    "homepage": "https://github.com/lengyuesky/tgdrive-app",
    "support": "https://github.com/lengyuesky/tgdrive-app/issues",
    "screenshots": [
      "screenshots/home.png"
    ],
    "data_schema": 1
  }
}

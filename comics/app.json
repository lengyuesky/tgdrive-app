{
  "id": "comics",
  "name": "漫画",
  "version": "1.4.6",
  "api_version": 2,
  "min_host_version": "0.3.1",
  "description": "阅读图片文件夹和 CBZ/ZIP 漫画，支持封面海报、连续滚动、左右单页翻阅、书签和跨设备阅读进度。",
  "author": "tgdrive",
  "entry": "index.html",
  "icon": "icon.svg",
  "permissions": [
    "files.read",
    "media.read"
  ],
  "settings": [],
  "integration": {
    "file_types": [
      "cbz",
      "zip"
    ],
    "directories": true,
    "changelog": "只读请求统一限并发并优先正文与当前页，封面读取降低优先级；限流退避加入随机抖动，排队可取消且有容量与时间上限，不阻塞进度保存和退出。",
    "formats": [
      "图片目录",
      "CBZ",
      "ZIP"
    ],
    "limitations": [
      "不支持加密归档、RAR、CBR 或 7Z。",
      "归档上限 2 GiB，图片章最多 10000 页；按可见范围读取图片。"
    ],
    "homepage": "https://github.com/lengyuesky/tgdrive-app",
    "support": "https://github.com/lengyuesky/tgdrive-app/issues",
    "screenshots": [
      "screenshots/home.png"
    ],
    "data_schema": 1
  }
}
